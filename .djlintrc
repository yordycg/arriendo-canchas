{
  "indent": 2,
  "profile": "django",
  "ignore": "H021,H030,H031,D018",
  "blank_line_after_tag": "load,extends,include",
  "line_break_after_multiline_tag": true,
  "max_line_length": 200,
  "format_js": true,
  "format_css": true,
  "preserve_blank_lines": true,
  "preserve_leading_space": true
}
